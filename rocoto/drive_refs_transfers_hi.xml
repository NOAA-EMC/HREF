<?xml version="1.0"?>
<!DOCTYPE workflow
[

<!ENTITY STARTYEAR "2025">
<!ENTITY STARTMONTH "05">
<!ENTITY STARTDAY "10">
<!ENTITY STARTHOUR "12">

<!ENTITY ENDYEAR "2025">
<!ENTITY ENDMONTH "12">
<!ENTITY ENDDAY "31">
<!ENTITY ENDHOUR "12">

<!ENTITY USER "emc.lam">
<!ENTITY machine "WCOSS2">
<!ENTITY ACCOUNT "RRFS-DEV">

<!ENTITY HOMEfv3 "/lfs/h2/emc/lam/noscrub/emc.lam/enspost/refs.v1.0.0">
<!ENTITY JOBS "&HOMEfv3;/rocoto">
<!ENTITY OUTDIR "/lfs/h2/emc/ptmp/&USER;">
<!ENTITY COMOUT_ENSPOST "/lfs/h2/emc/ptmp/emc.lam/para/com/refs/v1.0">
<!ENTITY NWGES "/lfs/h2/emc/ptmp/emc.lam/rrfs/pr/nwges">

<!ENTITY RESERVATION_TRANSFER '<queue>dev_transfer</queue><account>&ACCOUNT;</account>'>

<!ENTITY SEND_NODES '1:ppn=1'>
<!ENTITY SEND_RESOURCES '<walltime>04:40:00</walltime>'>

]>


<!--  ************************************************************* -->
<!--  ******************* STARTING THE WORKFLOW ******************* -->

<workflow realtime="T" scheduler="pbspro" taskthrottle="5" cyclethrottle="10" cyclelifespan="00:32:00:00">

  <cycledef group="regional">&STARTYEAR;&STARTMONTH;&STARTDAY;&STARTHOUR;00 &ENDYEAR;&ENDMONTH;&ENDDAY;&ENDHOUR;00 06:00:00</cycledef>

  <log>
    <cyclestr>&OUTDIR;/logfiles/workflow_regional_@Y@m@d@H.log</cyclestr>
  </log>


<!-- ******************************************************************* -->
<!-- ************************* Transfer Jobs *************************** -->


<!-- ****** AWS transfer - enspost                   ****** -->

  <task name="count_files" cycledefs="regional" maxtries="12">
    &RESERVATION_TRANSFER;
    &SEND_RESOURCES;

    <command>&JOBS;/launch.sh &JOBS;/JRRFS_COUNT_DOM</command>
    <nodes>&SEND_NODES;</nodes>
    <jobname><cyclestr>count_files_@H</cyclestr></jobname>
    <join><cyclestr>&OUTDIR;/logfiles/count_files_hi_@H.log</cyclestr></join>  

    <envar><name>job</name><value>count_files</value></envar>
    <envar><name>machine</name><value>&machine;</value></envar>
    <envar><name>USER</name><value>&USER;</value></envar>
    <envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
    <envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
    <envar><name>DOM</name><value>hi</value></envar>

    <dependency>
        <and>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f60.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f60.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f48.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f48.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f24.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f24.grib2</cyclestr></datadep>
        </and>
    </dependency>

  </task>

  <task name="send_enspost_tl" cycledefs="regional" maxtries="1">
    &RESERVATION_TRANSFER;
    &SEND_RESOURCES;

    <command>&JOBS;/launch.sh &JOBS;/JRRFSA_SENDENSPOST_AWS_TL_DOM</command>
    <nodes>&SEND_NODES;</nodes>
    <jobname><cyclestr>send_enspostaws_single_tl_@H</cyclestr></jobname>
    <join><cyclestr>&OUTDIR;/logfiles/send_enspostaws_single_tl_hi_@H.log</cyclestr></join>  

    <envar><name>HOMEfv3</name><value>&HOMEfv3;</value></envar>
    <envar><name>job</name><value>sendpostaws_single_tl</value></envar>
    <envar><name>machine</name><value>&machine;</value></envar>
    <envar><name>USER</name><value>&USER;</value></envar>
    <envar><name>CDATE</name><value><cyclestr>@Y@m@d@H</cyclestr></value></envar>
    <envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
    <envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
    <envar><name>tmmark</name><value>tm00</value></envar>
    <envar><name>DOM</name><value>hi</value></envar>

    <dependency>
        <and>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f60.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f60.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f48.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f48.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f36.grib2</cyclestr></datadep>
          <datadep age="05:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f36.grib2</cyclestr></datadep>
          <taskdep task="count_files"/>
        </and>
    </dependency>

  </task>



  <task name="mirror_enspost_tl" cycledefs="regional" maxtries="1">
    &RESERVATION_TRANSFER;
    &SEND_RESOURCES;

    <command>&JOBS;/launch.sh &JOBS;/JREGIONAL_MIRROR_ENSPOST_DOM</command>
    <nodes>&SEND_NODES;</nodes>
    <jobname><cyclestr>mirror_enspost_@H</cyclestr></jobname>
    <join><cyclestr>&OUTDIR;/logfiles/mirror_enspost_hi_@H.log</cyclestr></join>  

    <envar><name>HOMEfv3</name><value>&HOMEfv3;</value></envar>
    <envar><name>job</name><value>mirror_enspost</value></envar>
    <envar><name>machine</name><value>&machine;</value></envar>
    <envar><name>USER</name><value>&USER;</value></envar>
    <envar><name>CDATE</name><value><cyclestr>@Y@m@d@H</cyclestr></value></envar>
    <envar><name>PDY</name><value><cyclestr>@Y@m@d</cyclestr></value></envar>
    <envar><name>cyc</name><value><cyclestr>@H</cyclestr></value></envar>
    <envar><name>tmmark</name><value>tm00</value></envar>
    <envar><name>DOM</name><value>hi</value></envar>

    <dependency>
        <and>
          <datadep age="07:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f60.grib2</cyclestr></datadep>
          <datadep age="07:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f60.grib2</cyclestr></datadep>
          <datadep age="07:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.eas.f36.grib2</cyclestr></datadep>
          <datadep age="07:00"><cyclestr>&COMOUT_ENSPOST;/refs.@Y@m@d/ensprod/refs.t@Hz.hi.prob.f36.grib2</cyclestr></datadep>
          <taskdep task="count_files"/>
        </and>
    </dependency>

  </task>


</workflow>
